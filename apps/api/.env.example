# Copy to apps/api/.env and fill in. Never commit .env.
# The API reads apps/api/.env wherever it is started from; real environment
# variables (e.g. on Render) override it.

# Any Postgres URL spelling works (Neon/Render strings as-is); it is converted to
# postgresql+asyncpg. Port 5435 matches docker-compose.
DATABASE_URL=postgresql+asyncpg://leadforge:password123@localhost:5435/leadforge

CORS_ORIGINS=http://localhost:3001

# --- Auth ---
# development | staging | production. Outside development the API refuses to
# start without JWT_SECRET. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Key for automation (Apollo, Clay, n8n) calling ingest/research/score/draft and
# the unsubscribe webhook, sent as X-API-Key. Leave empty to disable.
SERVICE_API_KEY=
# Public URL of this API, used in email unsubscribe links and shown on Integrations
PUBLIC_API_URL=http://localhost:8000
AGENCY_POSTAL_ADDRESS=Your Agency Name, Street, City, State ZIP
# Optional: create this admin on start-up if the email doesn't exist yet
# (min 12-character password). Existing users are never changed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- AI ---
GEMINI_API_KEY=
LEADFORGE_MODEL=gemini-2.5-flash

# --- Email ---
# Leave SMTP_USERNAME/SMTP_PASSWORD empty to log approved emails instead of sending.
# Port 587 uses STARTTLS, 465 uses implicit TLS.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Integrations (shown as "set up" on the Integrations page) ---
APOLLO_API_KEY=
CLAY_API_KEY=
