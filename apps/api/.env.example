# Copy to .env and fill in. Never commit .env.

CORS_ORIGINS=http://localhost:3001

# --- Auth ---
# development | staging | production. Outside development the API refuses to
# start without JWT_SECRET. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Key for automation (n8n) calling ingest/research/score/draft, sent as X-API-Key.
# Leave empty to disable. Generate it the same way as JWT_SECRET.
SERVICE_API_KEY=
# Public URL of this API, used in email unsubscribe links
PUBLIC_API_URL=http://localhost:8000
AGENCY_POSTAL_ADDRESS=Your Agency Name, Street, City, State ZIP

GEMINI_API_KEY=
LEADFORGE_MODEL=gemini-2.5-flash

# Not needed for Phase 1 POC (poc.py doesn't touch these yet):
APOLLO_API_KEY=
CLAY_API_KEY=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
DATABASE_URL=postgresql://user:pass@localhost:5432/leadforge
